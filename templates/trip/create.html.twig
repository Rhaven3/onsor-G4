{% extends 'base.html.twig' %}
{% form_theme form 'views/form-theme.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
{% endblock %}

{% block body %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {{ form_start(form, {
            attr: {
                class: 'grid grid-cols-1 md:grid-cols-2 gap-6 space-y-3'
            }
        }) }}
        <div class="mt-10 sm:mx-auto w-full lg:max-w-[500px]">
            {{ form_row(form.name) }}
            {{ form_row(form.startDate) }}
            {{ form_row(form.endDate) }}
            {{ form_row(form.limitRegistrationDate) }}
            {{ form_row(form.maxRegistration) }}
            {{ form_row(form.description) }}
            {{ form_row(form.site) }}
        </div>
        <div class="mt-10 sm:mx-auto w-full lg:max-w-[500px]">
            {{ form_row(form.choiceMethodAddress) }}
            {{ form_row(form.address) }}
            {{ form_row(form.newAddress) }}
            <div class="flex gap-2 mt-10">
                {{ form_row(form._token) }}
                <button
                    type="submit"
                    class="flex w-full justify-center rounded-md hover:bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow bg-indigo-500"
                >Enregistrer
                </button>
                {% if published %}
                    <button name="published" value="true"
                            class="bg-green-500 hover:bg-green-700 flex w-full justify-center rounded-md px-3 py-2 text-sm font-semibold text-white shadow"
                    >Publier
                    </button>
                {% endif %}
            </div>

        </div>
        {{ form_end(form) }}
        {#    Affichage carte Leaflet #}
        <div id="map" class="mt-10 sm:mx-auto md:h-[500px] h-[300px] w-full lg:w-[500px]"></div>
    </div>
{% endblock %}

{% block title %}

{% endblock %}

