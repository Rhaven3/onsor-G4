{% extends 'base.html.twig' %}

{% block title %}Filtrer les sorties{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-50/50 py-8 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto space-y-8">
            {% if app.user %}
                <a href="{{ path('trip_create') }}"
                   class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-lg transition duration-200 shadow-sm">
                    Créer une sortie
                </a>
                <a href="{{ path('trip_listCreated') }}"
                   class="inline-block bg-gray-600 hover:bg-gray-700 text-white font-medium px-5 py-2.5 rounded-lg transition duration-200 shadow-sm">
                    Afficher vos sortie(s) non publiée(s)
                </a>
            {% endif %}

            {% if filterForm is defined %}
            <!-- Section Filtre -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 sm:p-8 w-full">
                {{ form_start(filterForm) }}
                <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                    </svg>
                    Filtrer les sorties publiées
                </h2>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Colonne 1 : Champs de saisie -->
                    <div class="space-y-4">
                        <div class="flex flex-col">
                            {{ form_label(filterForm.site, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                            {{ form_widget(filterForm.site, {'attr': {'class': 'w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none text-gray-900'}}) }}
                            {{ form_errors(filterForm.site, {'attr': {'class': 'mt-1 text-xs text-red-600 font-medium'}}) }}
                        </div>

                        <div class="flex flex-col">
                            {{ form_label(filterForm.name, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                            {{ form_widget(filterForm.name, {'attr': {'placeholder': 'Rechercher un mot clé...', 'class': 'w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none text-gray-900'}}) }}
                            {{ form_errors(filterForm.name, {'attr': {'class': 'mt-1 text-xs text-red-600 font-medium'}}) }}
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="flex flex-col">
                                {{ form_label(filterForm.dateStart, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                                {{ form_widget(filterForm.dateStart, {'attr': {'class': 'w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none text-gray-900'}}) }}
                                {{ form_errors(filterForm.dateStart, {'attr': {'class': 'mt-1 text-xs text-red-600 font-medium'}}) }}
                            </div>
                            <div class="flex flex-col">
                                {{ form_label(filterForm.dateEnd, null, {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 mb-1.5'}}) }}
                                {{ form_widget(filterForm.dateEnd, {'attr': {'class': 'w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none text-gray-900'}}) }}
                                {{ form_errors(filterForm.dateEnd, {'attr': {'class': 'mt-1 text-xs text-red-600 font-medium'}}) }}
                            </div>
                        </div>
                    </div>

                    <!-- Colonne 2 : Checkboxes style moderne -->
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4 bg-gray-50 p-4 rounded-xl border border-gray-100">
                        {% set checkboxes = [
                            {'field': filterForm.organizer, 'label': "Sorties dont je suis l'organisateur/trice"},
                            {'field': filterForm.register, 'label': "Sorties auxquelles je suis inscrit/e"},
                            {'field': filterForm.notRegister, 'label': "Sorties auxquelles je ne suis pas inscrit/e"},
                            {'field': filterForm.ended, 'label': "Sorties passées"}
                        ] %}

                        {% for check in checkboxes %}
                            <label
                                class="flex items-center p-3 bg-white rounded-lg border border-gray-200 shadow-sm cursor-pointer hover:bg-blue-50/30 hover:border-blue-200 transition group select-none">
                                {{ form_widget(check.field, {'attr': {'class': 'peer h-5 w-5 text-blue-600 rounded border-gray-300 focus:ring-blue-500 transition'}}) }}
                                <span
                                    class="ml-3 text-sm font-medium text-gray-700 group-hover:text-gray-900 transition">
                                    {{ check.label }}
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <!-- Boutons -->
                <div class="mt-6 pt-4 border-t border-gray-100 flex justify-end">
                    <button type="submit"
                            class="w-full sm:w-auto inline-flex justify-center items-center px-6 py-3 border border-transparent text-base font-semibold rounded-xl text-white bg-blue-600 hover:bg-blue-700 shadow-sm hover:shadow-md transition-all focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 cursor-pointer">
                        Filtrer les résultats
                    </button>
                </div>
                {{ form_end(filterForm) }}
            </div>
            {% endif %}

            <!-- Liste des Sorties -->
            <div class="space-y-4">
                <div class="flex justify-between items-center px-2">
                    <h3 class="text-lg font-bold text-gray-900">Résultats de la recherche</h3>
                    <span class="text-sm text-gray-500 font-medium">{{ trips|length }} sortie(s) trouvée(s)</span>
                </div>

                <!-- Mode Desktop : Tableau -->
                <div class="hidden md:block bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200 text-center">
                            <thead class="bg-gray-50/70 text-center">
                            <tr>
                                <th scope="col"
                                    class="px-6 py-3.5  text-xs font-bold text-gray-500 uppercase tracking-wider">Nom
                                </th>
                                <th scope="col"
                                    class="px-6 py-3.5  text-xs font-bold text-gray-500 uppercase tracking-wider">Date
                                </th>
                                <th scope="col"
                                    class="px-6 py-3.5  text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Clôture
                                </th>
                                <th scope="col"
                                    class="px-6 py-3.5  text-xs font-bold text-gray-500 uppercase tracking-wider">Places
                                </th>
                                <th scope="col"
                                    class="px-6 py-3.5  text-xs font-bold text-gray-500 uppercase tracking-wider">État
                                </th>
                                <th scope="col"
                                    class="px-6 py-3.5  text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Inscrit
                                </th>
                                <th scope="col"
                                    class="px-6 py-3.5  text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Organisateur
                                </th>
                                <th scope="col"
                                    class="px-6 py-3.5 class text-center text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Actions
                                </th>
                            </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-100">
                            {% for trip in trips %}
                                <tr class="hover:bg-gray-50/80 transition">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">{{ trip.name }}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">{{ trip.endDate | date('d/m/Y') }}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ trip.limitRegistrationDate | date('d/m/Y') }}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium text-gray-900">
                                        <span class="inline-block px-2.5 py-1 bg-gray-100 rounded-md text-xs">
                                            {{ trip.participants|length }} / <span
                                                class="text-gray-500">{{ trip.maxRegistration }}</span>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm">
                                        {%- set badgeClass = 'bg-green-50 text-green-700' -%}
                                        {%- set statusLabel = 'Ouverte' -%}

                                        {% if trip.state %}
                                            {% set badgeClass = 'bg-red-50 text-red-700' %}
                                            {% set statusLabel = trip.state.value %}
                                            {% if trip.state.value == 'Créée' %}
                                                {% set badgeClass = 'bg-blue-50 text-blue-700' %}
                                                {% set statusLabel = trip.state.value %}
                                            {% endif %}
                                        {% elseif trip.participants|length == trip.maxRegistration %}
                                            {% set badgeClass = 'bg-orange-50 text-orange-700' %}
                                            {% set statusLabel = 'Clôturé' %}
                                        {% elseif trip.endDate < date('now') %}
                                            {% set badgeClass = 'bg-gray-100 text-gray-600' %}
                                            {% set statusLabel = 'Passée' %}
                                        {% elseif (trip.endDate > date('now')) and (trip.startDate < date('now')) %}
                                            {% set badgeClass = 'bg-yellow-50 text-yellow-700' %}
                                            {% set statusLabel = 'En cours' %}
                                        {% endif %}


                                        <span
                                            class="px-2.5 py-1 inline-flex text-xs font-semibold rounded-full border {{ badgeClass }}">
                                            {{ statusLabel }}
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm">
                                        {% if app.user and app.user in trip.participants %}
                                            <span
                                                class="inline-flex items-center justify-center h-6 w-6 rounded-full bg-green-50 text-green-600 border border-green-200">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                     viewBox="0 0 24 24"><path stroke-linecap="round"
                                                                               stroke-linejoin="round" stroke-width="2"
                                                                               d="M5 13l4 4L19 7"></path></svg>
                                            </span>
                                        {% else %}
                                            <span
                                                class="inline-flex items-center justify-center h-6 w-6 rounded-full bg-gray-50 text-gray-400 border border-gray-200">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 font-medium">
                                        <a href="{{ path('app_user_show_id', {'id': trip.organisator.id}) }}">{{ trip.organisator.firstName }} {{ trip.organisator.lastName }}</a>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                                        <div class="flex justify-end gap-2">
                                            <a href="{{ path('trip_detail',{'id' : trip.id}) }}"
                                               class="inline-flex items-center px-2.5 py-1.5 border border-gray-200 rounded-lg text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50 transition shadow-sm">Afficher</a>
                                            {% if app.user and (trip.limitRegistrationDate > date('now')) and trip.state is null %}
                                                {% if app.user.id == trip.organisator.id %}
                                                    <a href="{{ path('trip_update', {'id': trip.id}) }}"
                                                       class="inline-flex items-center px-2.5 py-1.5 rounded-lg text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition">Modifier</a>
                                                {% elseif app.user in trip.participants %}
                                                    <a href="{{ path('trip_withdraw',{'id' : trip.id}) }}"
                                                       class="inline-flex items-center px-2.5 py-1.5 rounded-lg text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 transition">Se
                                                        désister</a>
                                                {% else %}
                                                    <a href="{{ path('trip_register',{'id' : trip.id}) }}"
                                                       class="inline-flex items-center px-2.5 py-1.5 rounded-lg text-xs font-semibold text-green-700 bg-green-50 hover:bg-green-100 transition">S'inscrire</a>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8" class="px-6 py-12 text-center text-gray-500">
                                        <svg class="mx-auto h-12 w-12 text-gray-300 mb-3" fill="none"
                                             stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <p class="text-base font-medium">Aucune sortie trouvée</p>
                                        <p class="text-sm text-gray-400 mt-1">Modifiez vos critères de recherche pour
                                            obtenir des résultats.</p>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Mode Mobile : Liste de Cartes (Cards) -->
                <div class="block md:hidden space-y-4">
                    {% for trip in trips %}
                        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 space-y-3">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h4 class="font-bold text-gray-900 text-base">{{ trip.name }}</h4>
                                    <p class="text-xs text-gray-500 mt-0.5">
                                        Par {{ trip.organisator.firstName }} {{ trip.organisator.lastName }}</p>
                                </div>
                                {# Utilisation des mêmes variables d'états que le tableau desktop #}
                                {% if trip.state %}{% set badge, lbl = 'bg-red-50 text-red-700', trip.state.value %}
                                {% elseif trip.participants|length == trip.maxRegistration %}{% set badge, lbl = 'bg-orange-50 text-orange-700 border-orange-200', 'Clôturé' %}
                                {% elseif trip.endDate < date('now') %}{% set badge, lbl = 'bg-gray-100 text-gray-600 border-gray-300', 'Passée' %}
                                {% elseif (trip.endDate > date('now')) and (trip.startDate < date('now')) %}{% set badge, lbl = 'bg-yellow-50 text-yellow-700', 'En cours' %}
                                {% else %}{% set badge, lbl = 'bg-green-50 text-green-700 border-green-200', 'Ouverte' %}{% endif %}
                                <span
                                    class="px-2 py-0.5 text-2xs font-semibold rounded-full border {{ badge }}">{{ lbl }}</span>
                            </div>

                            <div class="grid grid-cols-2 gap-2 text-xs py-2 border-y border-gray-50 text-gray-600">
                                <div><span class="text-gray-400">Date :</span> {{ trip.endDate | date('d/m/Y') }}</div>
                                <div><span
                                        class="text-gray-400">Clôture :</span> {{ trip.limitRegistrationDate | date('d/m/Y') }}
                                </div>
                                <div><span class="text-gray-400">Places :</span> {{ trip.participants|length }}
                                    /{{ trip.maxRegistration }}</div>
                                <div><span
                                        class="text-gray-400">Inscrit ? :</span> {% if app.user and app.user in trip.participants %}
                                        <span class="text-green-600 font-semibold">Oui</span>{% else %}Non{% endif %}
                                </div>
                            </div>

                            <div class="flex gap-2 pt-1">
                                <a href="{{ path('trip_detail',{'id' : trip.id}) }}"
                                   class="flex-1 text-center py-2 border border-gray-200 rounded-lg text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50 transition">Afficher</a>
                                {% if app.user and (trip.limitRegistrationDate > date('now')) and trip.state is null %}
                                    {% if app.user.id == trip.organisator.id %}
                                        <a href="{{ path('trip_update', {'id': trip.id}) }}"
                                           class="flex-1 text-center py-2 rounded-lg text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition">Modifier</a>
                                    {% elseif app.user in trip.participants %}
                                        <a href="{{ path('trip_withdraw',{'id' : trip.id}) }}"
                                           class="flex-1 text-center py-2 rounded-lg text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 transition">Se
                                            désister</a>
                                    {% else %}
                                        <a href="{{ path('trip_register',{'id' : trip.id}) }}"
                                           class="flex-1 text-center py-2 rounded-lg text-xs font-semibold text-white bg-green-600 hover:bg-green-700 transition">S'inscrire</a>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <div class="bg-white rounded-xl p-8 text-center text-gray-400 text-sm border border-gray-100">
                            Aucune sortie trouvée.
                        </div>
                    {% endfor %}
                </div>

            </div>
        </div>
    </div>
{% endblock %}
