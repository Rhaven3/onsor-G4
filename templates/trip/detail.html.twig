{% extends 'base.html.twig' %}

{% block body %}
    <div class="max-w-6xl mx-auto p-4 md:p-8 space-y-8 bg-gray-50 min-h-screen">

        <!-- 1. EN-TÊTE DU TRIP -->
        <div
            class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
            <span
                class="bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider m-1">
                Site : {{ trip.site.name }}
            </span>

                {% if trip.state?.value == 'Créée' %}
                    {% set badgeClass = 'bg-blue-100 text-blue-800' %}
                    {% set statusLabel = trip.state.value %}
                {% elseif trip.state is not null %}
                    {% set badgeClass = 'bg-red-50 text-red-700' %}
                    {% set statusLabel = trip.state.value %}
                {% endif %}
                {% if trip.state is null %}
                    {% if trip.participants|length == trip.maxRegistration %}
                        {% set badgeClass = 'bg-orange-50 text-orange-700' %}
                        {% set statusLabel = 'Clôturé' %}
                    {% elseif trip.endDate < date('now') %}
                        {% set badgeClass = 'bg-gray-100 text-gray-600' %}
                        {% set statusLabel = 'Passée' %}
                    {% elseif (trip.endDate > date('now')) and (trip.startDate < date('now')) %}
                        {% set badgeClass = 'bg-yellow-50 text-yellow-700' %}
                        {% set statusLabel = 'En cours' %}
                    {% else %}
                        {% set badgeClass = 'bg-green-100 text-green-700' %}
                        {% set statusLabel = 'Ouverte' %}
                    {% endif %}
                {% endif %}

                <span
                    class="{{ badgeClass }} text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
                ETAT : {{ statusLabel }}
            </span>

                <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 mt-2">{{ trip.name }}</h1>
            </div>

            <div class="w-full md:w-auto md:ml-auto flex flex-col sm:flex-row md:flex-nowrap gap-2 justify-center text-center">
                {% if app.user and (trip.limitRegistrationDate > date('now')) %}
                    {% if is_granted("ROLE_ADMIN") and ( trip.state?.value != 'Archivée' or trip.state is null) %}
                        <a href="{{ path('trip_archive', {'id': trip.id}) }}"
                           class="inline-block bg-red-600 hover:bg-red-700 text-white font-medium px-5 py-2.5 rounded-lg transition duration-200 shadow-sm justify-center">
                            Archivée
                        </a>
                    {% endif %}

                    {% if trip.state is null or trip.state.value == 'Créée' %}

                        {% if trip.organisator == app.user or is_granted("ROLE_ADMIN") %}
                            <button
                                data-controller="popup"
                                data-popup-url-value="{{ path('trip_cancel', {'id': trip.id}) }}"
                                data-action="click->popup#open"
                                class="btn btn-primary inline-block bg-red-600 hover:bg-red-700 text-white font-medium px-5 py-2.5 rounded-lg transition duration-200 shadow-sm">
                                Annuler
                            </button>
                        {% endif %}
                        {% if trip.organisator == app.user %}
                            <a href="{{ path('trip_update', {'id': trip.id}) }}"
                               class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-lg transition duration-200 shadow-sm">
                                Modifier
                            </a>
                            {% if trip.state?.value == 'Créée' %}
                                <a href="{{ path('trip_publish', {'id': trip.id}) }}"
                                   class="inline-block bg-green-600 hover:bg-green-700 text-white font-medium px-5 py-2.5 rounded-lg transition duration-200 shadow-sm">
                                    Publiée
                                </a>
                            {% endif %}
                        {% elseif app.user in trip.participants  and trip.state is null %}
                            <a href="{{ path('trip_withdrawDetail', {'id': trip.id}) }}"
                               class="inline-block bg-red-600 hover:bg-red-700 text-white font-medium px-5 py-2.5 rounded-lg transition duration-200 shadow-sm">
                                Se désister
                            </a>
                        {% elseif (app.user not in trip.participants and trip.state is null) %}
                            <a href="{{ path('trip_register', {'id': trip.id}) }}"
                               class="inline-block bg-green-600 hover:bg-green-700 text-white font-medium px-5 py-2.5 rounded-lg transition duration-200 shadow-sm">
                                S'inscrire
                            </a>
                        {% endif %}
                    {% endif %}

                {% endif %}
            </div>


            <div class="flex items-center gap-3 bg-gray-50 p-3 rounded-xl border border-gray-100">


                <div>
                    <p class="text-xs text-gray-500 font-medium">Organisé par</p>
                    <p class="text-sm font-semibold text-gray-800">
                        <a href="{{ path('app_user_show_id', {'id': trip.organisator.id}) }}">{{ trip.organisator.firstName }} {{ trip.organisator.LastName }}</a>
                    </p>
                </div>
            </div>
        </div>

        <!-- 2. INFORMATIONS PRINCIPALES (Grille 2 colonnes) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- COLONNE GAUCHE (Détails & Description) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Infos clés -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100">Détails de la
                        sortie</h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-gray-600">
                        <div class="flex flex-col gap-1">
                            <span class="text-xs font-semibold text-gray-400 uppercase">Début de la sortie</span>
                            <span class="font-medium text-gray-800">📅 {{ trip.startDate | date('d/m/Y') }}</span>.
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-xs font-semibold text-gray-400 uppercase">Fin de la sortie</span>
                            <span class="font-medium text-gray-800">🏁 {{ trip.endDate | date('d/m/Y') }}</span>
                        </div>
                        <div
                            class="flex flex-col gap-1 sm:col-span-2 p-3 bg-amber-50 border border-amber-100 rounded-xl">
                            <span class="text-xs font-semibold text-amber-700 uppercase">Clôture des inscriptions</span>
                            <span
                                class="font-semibold text-amber-900">⏰ {{ trip.limitRegistrationDate | date('d/m/Y') }}</span>
                        </div>
                    </div>

                    <div class="mt-6">
                        <span class="text-xs font-semibold text-gray-400 uppercase block mb-2">Description</span>
                        <p class="text-gray-600 leading-relaxed bg-gray-50 p-4 rounded-xl border border-gray-100">
                            {{ trip.description }}
                        </p>
                    </div>
                </div>
            </div>

            <!-- COLONNE DROITE (Lieu & Jauge) -->
            <div class="space-y-6">
                <!-- Jauge Participants -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center">
                    <span class="text-xs font-semibold text-gray-400 uppercase block mb-1">Places disponibles</span>
                    <div class="text-3xl font-black text-gray-900 my-2">
                        {{ trip.participants|length }} <span
                            class="text-gray-400 text-lg font-normal">/ {{ trip.maxRegistration }}</span>
                    </div>
                    <!-- Barre de progression visuelle -->
                    <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden mt-3">
                        {% set percentage = (trip.participants|length / trip.maxRegistration) * 100 %}
                        <div class="bg-blue-600 h-full rounded-full transition-all duration-500"
                             style="width: {{ percentage }}%"></div>
                    </div>
                </div>

                <!-- Adresse -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100">📍 Lieu du
                        rendez-vous</h2>
                    <div class="space-y-3 text-sm">
                        {% if trip.address %}
                            <div>
                                <span class="font-semibold text-gray-800 block">{{ trip.address.name }}</span>
                                <span class="text-gray-600 block">{{ trip.address.street }}</span>
                                <span
                                    class="text-gray-600 block">{{ trip.address.city }} {{ trip.address.postcode }}</span>
                            </div>

                            <div
                                class="pt-3 border-t border-gray-50 grid grid-cols-2 gap-2 text-xs text-gray-400 font-mono">
                                <div>Lat: {{ trip.address.latitude ?? 'N/A' }}</div>
                                <div>Long: {{ trip.address.longitude ?? 'N/A' }}</div>
                            </div>
                        {% else %}
                            <div class="text-gray-500 italic">Lieu non défini pour cette sortie.</div>
                        {% endif %}
                    </div>
                </div>

                <!-- 3. TABLEAU DES PARTICIPANTS -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="p-6 border-b border-gray-100">
                        <h3 class="text-lg font-bold text-gray-800">Liste des participants inscrits</h3>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                            <tr class="bg-gray-50 text-xs font-semibold uppercase text-gray-500 border-b border-gray-100">
                                <th class="py-4 px-6">Pseudo</th>
                                <th class="py-4 px-6">Nom</th>
                            </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
                            {% if app.user %}
                                {% for participant in trip.participants %}
                                    <tr class="hover:bg-gray-50/50 transition">
                                        <td class="py-4 px-6 font-medium text-blue-600"><a
                                                href="{{ path('app_user_show_id', {'id': participant.id}) }}">{{ participant.username }}</a>
                                        </td>
                                        <td class="py-4 px-6">{{ participant.firstName }} {{ participant.lastName }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="2" class="py-6 px-6 text-center text-gray-400 italic">
                                            Aucun participant inscrit pour le moment.
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="2" class="py-6 px-6 text-center text-gray-400 italic">
                                        Vous devez être connecté pour accéder à la liste des participants.
                                    </td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
