{% extends 'base.html.twig' %}
{% form_theme requestForm 'views/form-theme.html.twig' %}

{% block title %}Nouveau Mot de passe{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <div class="sm:mx-auto sm:w-full sm:max-w-sm">
        <h2 class="mt-10 text-center text-2xl font-bold tracking-tight text-gray-900">
            Changer votre mot de passe
        </h2>
    </div>

    <div class="sm:mx-auto sm:w-full sm:max-w-sm mt-6">
        {{ form_start(requestForm) }}
        {{ form_row(requestForm.email) }}
        <div>
            <small>
                Entrer un email, et nous vous enverrons
                un lien de réinitialisation.
            </small>
        </div>

        <button
            class="flex w-full justify-center rounded-md hover:bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow bg-indigo-500 mt-3">
            Envoyer
        </button>
        {{ form_end(requestForm) }}
    </div>
{% endblock %}
