{% extends 'base.html.twig' %}
{% form_theme resetForm 'views/form-theme.html.twig' %}

{% block title %}Nouveau Mot de passe{% endblock %}

{% block body %}
    <div class="sm:mx-auto sm:w-full sm:max-w-sm">
        <h2 class="mt-10 text-center text-2xl font-bold tracking-tight text-gray-900">
            Changer votre mot de passe
        </h2>
    </div>
    <div class="sm:mx-auto sm:w-full sm:max-w-sm mt-6">

        {{ form_start(resetForm) }}
        {{ form_row(resetForm.plainPassword) }}
        <button class="flex w-full justify-center rounded-md hover:bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow bg-indigo-500 mt-3">Réinitialiser</button>
        {{ form_end(resetForm) }}
    </div>
{% endblock %}
