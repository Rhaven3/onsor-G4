{% block form_row %}

    <div>
        {{ form_label(form, '', {
            label_attr: {
                class: 'block font-medium text-gray-900'
            }
        }) }}

        <div class="mt-2">
            {{ form_widget(form, {
                attr: {
                    class: 'block w-full rounded-md bg-white px-3 py-1.5 text-gray-900 outline outline-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:outline-indigo-600 sm:text-sm'
                }
            }) }}
        </div>

        <div class="text-red-500 list-disc" id="form-error">
        {{ form_errors(form) }}
        </div>
    </div>
{% endblock %}
